<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Acid @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <os-version min="10.13"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
    </choices-outline>
    <choice id="vst3" title="VST3 plugin" description="Installs Acid.vst3 into /Library/Audio/Plug-Ins/VST3">
        <pkg-ref id="com.acidproject.acid.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit plugin" description="Installs Acid.component into /Library/Audio/Plug-Ins/Components (Logic Pro, GarageBand, Ableton Live ...)">
        <pkg-ref id="com.acidproject.acid.au"/>
    </choice>
    <pkg-ref id="com.acidproject.acid.vst3" version="@VERSION@">Acid-vst3.pkg</pkg-ref>
    <pkg-ref id="com.acidproject.acid.au" version="@VERSION@">Acid-au.pkg</pkg-ref>
</installer-gui-script>
